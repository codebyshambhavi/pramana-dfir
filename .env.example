# Copy to .env and change every value. .env is git-ignored; never commit it.

# --- Postgres (docker-compose) ---
POSTGRES_USER=pramana
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pramana
DATABASE_URL=postgresql+psycopg2://pramana:change_me@db:5432/pramana

# --- Evidence storage ---
# Where uploaded evidence is stored. Must be outside the git tree for real cases.
UPLOAD_DIR=/data/uploads

# --- Gmail OAuth (server-side only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/cases/CASE-ID/connectors/gmail/callback

# --- Microsoft Graph OAuth (server-side only) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/cases/CASE-ID/connectors/microsoft/callback

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRAMANA_TOKEN_ENCRYPTION_KEY=

# Connector route authentication (required in production).
# This repository did not contain an existing user/authentication system.
# Generate a strong random bearer token and optionally scope it to case IDs.
PRAMANA_API_BEARER_TOKEN=
# JSON array of allowed case IDs. Leave unset to allow authenticated API access to all cases.
PRAMANA_AUTHORIZED_CASE_IDS=

# --- Demo ---
# 1 enables POST /evidence/{id}/simulate-tamper, which MODIFIES a stored evidence
# file so verification can be demonstrated. Never enable it on a real case.
DEMO_MODE=0

# --- Intelligence (Role 2) ---
# IANA timezone of the case. Wall-clock rules (odd-hours login) are evaluated in
# this timezone; raw timestamps are never rewritten. Default: UTC.
# PRAMANA_INTEL_TIMEZONE=Asia/Kolkata
# Optional per-source clock error, JSON. offset_seconds > 0 means the source clock
# runs AHEAD of true time; uncertainty_seconds is a symmetric +/- error.
# Sources: browser, chat, log, pcap, image.
# PRAMANA_SOURCE_CLOCKS={"log": {"offset_seconds": 240, "uncertainty_seconds": 120}}

# --- Optional local LLM (Ollama). Not used by the deterministic pipeline. ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
