# Copy to .env and change every value. .env is git-ignored; never commit it.

# --- Postgres (docker-compose) ---
POSTGRES_USER=pramana
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pramana
DATABASE_URL=postgresql+psycopg2://pramana:change_me@db:5432/pramana

# --- Evidence storage ---
# Where uploaded evidence is stored. Must be outside the git tree for real cases.
UPLOAD_DIR=/data/uploads

# --- Intelligence (Role 2) ---
# IANA timezone of the case. Wall-clock rules (odd-hours login) are evaluated in
# this timezone; raw timestamps are never rewritten. Default: UTC.
# PRAMANA_INTEL_TIMEZONE=Asia/Kolkata
# Optional per-source clock error, JSON. offset_seconds > 0 means the source clock
# runs AHEAD of true time; uncertainty_seconds is a symmetric +/- error.
# Sources: browser, chat, log, pcap, image.
# PRAMANA_SOURCE_CLOCKS={"log": {"offset_seconds": 240, "uncertainty_seconds": 120}}

# --- Optional local LLM (Ollama). Not used by the deterministic pipeline. ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
