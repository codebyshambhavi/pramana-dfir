{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pramana/hypothesis-template.schema.json",
  "title": "HypothesisTemplate",
  "description": "Deterministic hypothesis template schema for PRAMANA T7.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "description",
    "stages",
    "requires",
    "expects",
    "forbids",
    "constraints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H[0-9]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateItem" }
    },
    "expects": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateItem" }
    },
    "forbids": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateItem" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "templateItem": {
      "type": "object",
      "required": ["id", "stage", "description", "claim_type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "SAME_OBJECT_FLOW",
            "OFFHOURS_SESSION",
            "ACTOR_DEVICE_CONSISTENT",
            "LOCATION_CONFLICT",
            "NO_RECORD_IN_COVERED_WINDOW",
            "SESSION_ORIGIN_MISMATCH"
          ]
        },
        "source_kind": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "weight": {
          "type": "number",
          "minimum": 0.0
        },
        "critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["same", "before", "within"]
        },
        "target": {
          "type": "string",
          "enum": ["actor", "device"]
        },
        "first": {
          "type": "string"
        },
        "second": {
          "type": "string"
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
